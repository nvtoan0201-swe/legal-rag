# Empty QDRANT_URL = embedded local storage at QDRANT_PATH (no server, no Docker).
# Set QDRANT_URL=http://localhost:6333 to use a Qdrant server instead (docker compose).
QDRANT_URL=
QDRANT_PATH=data/qdrant

# Retrieval
# EMBED_BACKEND=bge-m3            # bge-m3 (default) or hashing (offline tests)
# RERANK_BACKEND=bge              # bge (default) or hashing
# DENSE_THRESHOLD=0.45
# RERANK_THRESHOLD=0.20
# EMBED_DEVICE=cuda               # cuda or cpu

# LLM (hosted API, OpenAI-compatible)
LLM_API_KEY=
# openai = any OpenAI-compatible server (OpenAI, OpenCode Go, Ollama, vLLM, LM Studio);
# anthropic = Messages API (set LLM_API_BASE=https://api.anthropic.com).
LLM_PROVIDER=openai
# Set true if the LLM host hangs on IPv6 (blackholed route): binds sockets to IPv4.
# LLM_IPV4_ONLY=true
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=
# Extra request headers for the hosted API, as JSON. Some gateways ask clients
# to send a stable session id and their own user agent, e.g. OpenCode Go:
# LLM_API_HEADERS={"x-opencode-session":"legal-rag","User-Agent":"legal-rag/0.1.0"}
# Some gateways expose the model list at a non-standard path (health check):
# LLM_MODELS_URL=https://opencode.ai/inference/go/v1/models
# Extra request body fields, as JSON (e.g. disable model reasoning so it does
# not consume the max_tokens budget):
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# Example: MiMo-V2.6-Flash served by the OpenCode Go gateway
# LLM_API_BASE=https://opencode.ai/inference/go/openai/v1
# LLM_API_KEY=<key from https://opencode.ai/console>
# LLM_MODEL=mimo-v2.6-flash
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}


# Offline mode for machines without IPv6/HF access (models must be cached first)
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

